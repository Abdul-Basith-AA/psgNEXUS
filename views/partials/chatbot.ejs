<!-- ==========================================================================
     PSG NEXUS OFFICIAL COLLEGE AI CHATBOT INTERFACE (MODERNIZED & RESTYLED)
     Matches the sleek Outfit & Glassmorphism design from samp.html
     ========================================================================== -->

<!-- FLOATING ACTION BUTTON (FAB LAUNCHER) -->
<button id="psg-chatbot-launcher" class="psg-fab-btn" title="Open PSG Nexus AI Assistant" aria-label="Open PSG Nexus AI Assistant">
  <!-- Custom SVG Logo: Academic Shield + AI Core Structure -->
  <svg viewBox="0 0 100 100" class="psg-fab-svg">
    <!-- Outer Shield (White) -->
    <path d="M50 5 L90 25 V50 C90 75 50 95 50 95 C50 95 10 75 10 50 V25 Z" fill="none" stroke="#ffffff" stroke-width="6" stroke-linejoin="round"/>
    <!-- Inner AI Core Structure (Light Blue) -->
    <circle cx="50" cy="45" r="15" fill="#0066cc"/>
    <circle cx="30" cy="30" r="4" fill="#ffffff"/>
    <circle cx="70" cy="30" r="4" fill="#ffffff"/>
    <circle cx="50" cy="75" r="5" fill="#ffffff"/>
    <!-- Cybernetic connection lines -->
    <line x1="50" y1="45" x2="30" y2="30" stroke="#ffffff" stroke-width="2"/>
    <line x1="50" y1="45" x2="70" y2="30" stroke="#ffffff" stroke-width="2"/>
    <line x1="50" y1="45" x2="50" y2="75" stroke="#ffffff" stroke-width="2"/>
  </svg>
  
  <!-- Notification Dot -->
  <span class="psg-fab-badge"></span>
</button>

<!-- CHATBOT WINDOW -->
<div id="psg-chatbot-window" class="chat-hidden">
  
  <!-- HEADER (PSG Tech Navy Gradient) -->
  <div class="psg-chat-header">
    <div class="psg-header-left">
      <!-- Custom AI Logo in Header -->
      <div class="psg-header-avatar">
        <svg viewBox="0 0 100 100" class="psg-avatar-svg">
          <path d="M50 10 L85 25 V50 C85 75 50 90 50 90 C50 90 15 75 15 50 V25 Z" fill="none" stroke="#0a2c66" stroke-width="6"/>
          <circle cx="50" cy="45" r="14" fill="#0066cc"/>
          <circle cx="50" cy="72" r="5" fill="#0a2c66"/>
        </svg>
      </div>
      <div>
        <h3 class="psg-header-title">
          Nexus AI
          <span class="psg-status-indicator">
            <span class="psg-ping"></span>
            <span class="psg-ping-dot"></span>
          </span>
        </h3>
        <p class="psg-header-sub">Digital Campus Guide</p>
      </div>
    </div>
    
    <div class="psg-header-actions">
      <button type="button" id="psg-reset-chat-btn" class="psg-header-action-btn" title="Clear chat history">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
          <path d="M21 3v5h-5"/>
          <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
          <path d="M8 16H3v5"/>
        </svg>
      </button>
      <button type="button" id="psg-close-chat-btn" class="psg-header-action-btn" title="Close chat">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- ROLE STATUS SUB-BAR (Role-Based Access Control) -->
  <div class="psg-role-strip">
    <div class="psg-role-info">
      <span class="psg-role-label">Active Role:</span>
      <span class="psg-role-badge" id="psg-active-role-badge">STUDENT</span>
    </div>
    <button type="button" class="psg-role-switch-btn" id="psg-switch-role-btn" title="Switch between Student, Faculty, Parent, and Visitor">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      Switch Role
    </button>
  </div>

  <!-- CHAT MESSAGES BODY -->
  <div id="psg-chat-messages" class="psg-chat-messages chat-scroll">
    <!-- ROLE SELECTOR MODAL CONTAINER -->
    <div id="psg-role-modal-container" style="display: none;"></div>
  </div>

  <!-- TYPING INDICATOR -->
  <div id="psg-typing-indicator" class="psg-typing-container hidden">
    <div class="psg-typing-avatar-spacer"></div>
    <div class="psg-typing-bubble">
      <svg width="24" height="12" viewBox="0 0 24 12">
        <circle cx="4" cy="6" r="3" class="psg-typing-dot" />
        <circle cx="12" cy="6" r="3" class="psg-typing-dot" />
        <circle cx="20" cy="6" r="3" class="psg-typing-dot" />
      </svg>
    </div>
  </div>

  <!-- INPUT AREA -->
  <div class="psg-chat-footer">
    <form id="psg-chat-form" class="psg-chat-form">
      <input 
        type="text" 
        id="psg-chat-input" 
        placeholder="Ask about PSG Tech..." 
        autocomplete="off" 
        class="psg-chat-input"
        required
      >
      <button type="submit" id="psg-send-btn" class="psg-send-btn" title="Send Query">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="psg-send-icon">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
    <div class="psg-footer-meta">
      🔒 Connected to Campus Hub • MongoDB Logged
    </div>
  </div>

</div>

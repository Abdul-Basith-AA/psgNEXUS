<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'PSG College of Technology' %></title>
  <link rel="shortcut icon" href="https://www.psgtech.edu/images/psgicon.ico">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts: Open Sans & Work Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&family=Work+Sans:wght@500;600;700&display=swap" rel="stylesheet">
  <!-- Custom Replica Portal CSS (>90% Match) -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Chatbot CSS (Bottom-Left) -->
  <link rel="stylesheet" href="/css/chatbot.css">
</head>
<body>

  <!-- =========================================================================
       1. TOPBAR / UTILITY BAR (EXACT REPLICA FROM PSGTECH.EDU)
       ========================================================================= -->
  <div class="tg-topbar">
    <div class="container-fluid px-lg-5">
      <div class="row align-items-center">
        <!-- News Ticker -->
        <div class="col-lg-6 col-md-5 d-none d-md-block">
          <div class="tg-tickerbox">
            <span class="tg-ticker-badge">NEWS</span>
            <div class="tg-ticker-content">
              <a href="#">Global Tender Invited for Procurement of Dry Guarded Hot Plate Tester (DGHPT) under Ministry of Textiles NTTM Project.</a>
            </div>
          </div>
        </div>

        <!-- Utility Top Links -->
        <div class="col-lg-6 col-md-7">
          <div class="tg-toplinks">
            <a href="#" class="toplink-btn toplink-special">Faculty Details</a>
            <a href="#" class="toplink-btn">Campus Map</a>
            <a href="#" class="toplink-btn">Mail</a>
            <a href="/forms" class="toplink-btn">Students</a>
            <a href="#" class="toplink-btn">Parents</a>
            <a href="#" class="toplink-btn">Alumni</a>
            <a href="#" class="toplink-btn">Careers</a>
            <a href="#" class="toplink-btn">IIC</a>
            <a href="/contact" class="toplink-btn">Help Desk</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       2. MIDDLE BRANDING HEADER (OFFICIAL LOGOS)
       ========================================================================= -->
  <div class="tg-middleheader">
    <div class="container-fluid px-lg-5">
      <div class="row align-items-center">
        <!-- Main Logo + ISO Badge -->
        <div class="col-md-7 col-12 mb-2 mb-md-0">
          <div class="tg-logo-wrap">
            <a href="/">
              <img src="https://www.psgtech.edu/images/logo.png" alt="PSG College of Technology" class="tg-main-logo">
            </a>
            <a href="#" class="tg-iso-badge d-none d-sm-inline-block">
              ISO certified 9001:2015
            </a>
          </div>
        </div>

        <!-- 75 & 100 Years Jubilee Crests -->
        <div class="col-md-5 col-12 text-md-end">
          <div class="tg-jubilee-logos">
            <a href="#" title="75 Years Platinum Jubilee">
              <img src="https://www.psgtech.edu/images/75yearsLogo_PSGCollegeofTech.png" alt="75 Years PSG Tech">
            </a>
            <a href="#" title="100 Years PSG & Sons Charities">
              <img src="https://www.psgtech.edu/images/100yearsLogo_PsgSonsCharities.png" alt="100 Years Charities">
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       3. MAIN NAVIGATION BAR (SIGNATURE ROYAL BLUE #2B4BAB)
       ========================================================================= -->

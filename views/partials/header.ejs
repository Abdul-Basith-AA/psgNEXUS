              <li><a class="dropdown-item" href="/academics">Autonomous Academic Calendar</a></li>
              <li><a class="dropdown-item" href="/academics">Scholarships & Placements</a></li>
              <li><a class="dropdown-item" href="/facilities">Dr. G.R.D. Memorial Library</a></li>
            </ul>
          </li>

          <!-- ADMISSIONS -->

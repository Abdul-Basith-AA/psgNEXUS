<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'PSG College of Technology' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Custom Portal CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Chatbot CSS -->
  <link rel="stylesheet" href="/css/chatbot.css">
</head>
<body>

  <!-- TOP HEADER ANNOUNCEMENT BAR -->
  <div class="top-header-bar">
    <div class="container d-flex justify-content-between align-items-center">
      <div>
        <span>📍 Peelamedu, Coimbatore - 641004</span>
        <span class="ms-3 d-none d-md-inline">📞 Helpline: 0422-4344777</span>
      </div>
      <div>
        <a href="/forms">Online Services</a>
        <a href="/admissions">Admissions 2026</a>
        <a href="/contact">Helpdesk</a>
      </div>
    </div>
  </div>

  <!-- MAIN COLLEGE BRAND HEADER -->
  <header class="college-brand-header">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center">
        <div class="college-logo-container">
          <div class="college-crest-icon">PSG</div>
          <div class="college-title">
            <h1>PSG COLLEGE OF TECHNOLOGY</h1>
            <p>Autonomous Institution • Affiliated to Anna University • Approved by AICTE • NAAC A+</p>
          </div>
        </div>
        <div class="d-none d-lg-block text-end">
          <span class="badge bg-primary px-3 py-2 text-uppercase font-monospace" style="letter-spacing: 0.5px;">
            🤖 PSG Nexus Assistant Active
          </span>
        </div>
      </div>
    </div>
  </header>

  <!-- NAVIGATION BAR -->
  <nav class="navbar navbar-expand-lg main-nav sticky-top">
    <div class="container">
      <button class="navbar-toggler text-white border-light" type="button" data-bs-toggle="collapse" data-bs-target="#psgNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="psgNavbar">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/' ? 'active' : '' %>" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/about' ? 'active' : '' %>" href="/about">About Us</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/academics' ? 'active' : '' %>" href="/academics">Academics & Syllabus</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/admissions' ? 'active' : '' %>" href="/admissions">Admissions & Fees</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/forms' ? 'active' : '' %>" href="/forms">Form Filling Portal</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/facilities' ? 'active' : '' %>" href="/facilities">Facilities & Hostels</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPage === '/contact' ? 'active' : '' %>" href="/contact">Contact</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

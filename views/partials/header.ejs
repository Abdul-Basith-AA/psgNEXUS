              <li><a class="dropdown-item" href="/admissions">B.E. / B.Tech Admissions (TNEA)</a></li>
              <li><a class="dropdown-item" href="/admissions">M.E. / M.Tech / MCA Admissions</a></li>
              <li><a class="dropdown-item" href="/admissions">Tuition & Hostel Fee Structure</a></li>
              <li><a class="dropdown-item" href="/admissions">NAAC Accreditation Data</a></li>
            </ul>

          <!-- CONTACT -->
          <li class="nav-item <%= currentPage === '/contact' ? 'active' : '' %>">
            <a class="nav-link" href="/contact">Contact</a>
          </li>
        </ul>

        <!-- LIVE ASSISTANT BADGE -->
        <div class="d-none d-xl-block">
          <span class="badge bg-warning text-dark font-monospace px-2 py-1" style="font-size: 11px;">
            🤖 PSG Nexus: Bottom-Left
          </span>
        </div>
      </div>
    </div>
  </nav>

        <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
      </button>

      <div class="collapse navbar-collapse" id="psgTechNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <!-- HOME -->
          <li class="nav-item <%= currentPage === '/' ? 'active' : '' %>">
            <a class="nav-link" href="/">Home</a>
          </li>

          <!-- ABOUT US -->
          <li class="nav-item dropdown <%= currentPage === '/about' ? 'active' : '' %>">
            <a class="nav-link dropdown-toggle" href="/about" data-bs-toggle="dropdown">About us</a>

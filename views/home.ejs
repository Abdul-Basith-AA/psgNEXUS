<!-- =========================================================================
     WELCOME SECTION (OFFICIAL PSG COLLEGE OF TECHNOLOGY TEXT)
     ========================================================================= -->
<section class="psg-welcome-section">
  <div class="container-fluid px-lg-5">
    <div class="row g-4 align-items-center">
      <div class="col-lg-8">
        <h2 class="psg-heading-title">Welcome to PSG College of Technology</h2>
        <p class="psg-welcome-text">
          <strong>PSG College of Technology</strong>, an ISO 9001:2015 certified institution, is one of the foremost institutions founded by the <strong>PSG & Sons' Charities Trust (1926)</strong>. The College was established in the year 1951, and the Founders wisely decided to locate it in the same campus as the PSG Industrial Institute for effective industry-institute interaction.
        </p>
        <p class="psg-welcome-text">
          The college is an autonomous institution affiliated to Anna University, Chennai, approved by AICTE, and accredited by NAAC with an <strong>A+ Grade</strong>. Equipped with modernized laboratory infrastructure, Centers of Excellence, and the G.R.D. Memorial Library, PSG Tech continues to nurture top-tier engineers, entrepreneurs, and researchers.
        </p>
      </div>

      <!-- KEY STATS CARDS -->
      <div class="col-lg-4">
        <div class="row g-2">
          <div class="col-6">
            <div class="psg-stat-card text-center">
              <h4>1951</h4>
              <p>Established Year</p>
            </div>
          </div>
          <div class="col-6">
            <div class="psg-stat-card text-center">
              <h4>NAAC A+</h4>
              <p>Accredited Institution</p>
            </div>
          </div>
          <div class="col-6">
            <div class="psg-stat-card text-center">
              <h4>60+</h4>
              <p>Academic Programmes</p>
            </div>
          </div>
          <div class="col-6">
            <div class="psg-stat-card text-center">
              <h4>Top 60</h4>
              <p>NIRF Ranking Band</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

